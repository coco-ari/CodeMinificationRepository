{
  "name": "code-minification-repository",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Gitee 源码分发与 Java、前端静态站点集中部署平台",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prestart": "pnpm run build",
    "start": "node src/server.mjs",
    "bundle:agent": "node scripts/bundle-agent.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:browser": "node test/browser-smoke.mjs",
    "test:deploy-browser": "node test/deploy-browser-smoke.mjs",
    "test:docker": "node test/docker-integration.mjs",
    "check": "node scripts/check.mjs && tsc --noEmit",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:prototype": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "test:prototype": "node test/prototype-browser-smoke.mjs && node test/prototype-core-edge-browser.mjs && node test/prototype-materials-browser.mjs && node test/prototype-agents-browser.mjs && node test/prototype-agent-edge-browser.mjs && node test/prototype-agent-interaction-browser.mjs && node test/prototype-cabinet-browser.mjs",
    "test:prototype:agent-interaction": "node test/prototype-agent-interaction-browser.mjs",
    "test:prototype:design": "node test/prototype-design-browser.mjs",
    "build:ui": "tsc --noEmit && vite build",
    "build": "pnpm run build:ui && node scripts/bundle-agent.mjs",
    "pretest": "pnpm run build:ui",
    "pretest:browser": "pnpm run build:ui",
    "pretest:deploy-browser": "pnpm run build:ui",
    "pretest:docker": "pnpm run build:ui",
    "format:ui": "prettier --write web vite.config.ts tsconfig.json components.json",
    "check:ui": "tsc --noEmit && prettier --check web vite.config.ts tsconfig.json components.json",
    "test:prototype:logic": "node --test test/prototype-v2-logic.test.mjs test/cabinet-prototype.test.mjs",
    "start:agent-demo": "node agent-demo/server.mjs",
    "start:agent-demo:t3": "node scripts/start-t3-worker.mjs",
    "bundle:customer-agent": "node scripts/bundle-customer-agent.mjs",
    "test:customer-agent": "node --test agent-demo/customer-agent/customer-agent.test.ts",
    "test:customer-agent:transport": "node --test agent-demo/customer-agent/transport-integration.test.ts",
    "test:customer-agent:distribution": "node --test agent-demo/customer-agent/distribution.test.ts",
    "test:agent-demo": "node test/agent-demo-api.mjs",
    "test:agent-demo:browser": "node test/agent-demo-browser.mjs",
    "test:agent-demo:restart": "node test/agent-demo-restart.mjs",
    "test:agent-demo:bridge": "node test/agent-demo-codex-bridge.mjs && node test/agent-demo-bridge-protocol.mjs",
    "test:agent-demo:soak": "node test/agent-demo-soak.mjs"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fflate": "0.8.3",
    "get-nonce": "1.0.1",
    "lucide-react": "^1.56.0",
    "motion": "^14.4.0",
    "officeparser": "8.2.0",
    "pdfjs-dist": "6.4.299",
    "pdfkit": "0.20.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "streaming-markdown": "0.2.15",
    "tailwind-merge": "^3.7.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxc-transform-react": "0.152.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
