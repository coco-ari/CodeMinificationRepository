{
  "name": "code-minification-repository",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Gitee 源码分发与 Java、前端静态站点集中部署平台",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prestart": "pnpm run build",
    "start": "node src/server.mjs",
    "bundle:agent": "node scripts/bundle-agent.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:browser": "node test/browser-smoke.mjs",
    "test:deploy-browser": "node test/deploy-browser-smoke.mjs",
    "test:docker": "node test/docker-integration.mjs",
    "check": "node scripts/check.mjs && tsc --noEmit",
    "dev:ui": "vite --host 127.0.0.1",
    "build:ui": "tsc --noEmit && vite build",
    "build": "pnpm run build:ui && node scripts/bundle-agent.mjs",
    "pretest": "pnpm run build:ui",
    "pretest:browser": "pnpm run build:ui",
    "pretest:deploy-browser": "pnpm run build:ui",
    "pretest:docker": "pnpm run build:ui",
    "format:ui": "prettier --write web vite.config.ts tsconfig.json components.json",
    "check:ui": "tsc --noEmit && prettier --check web vite.config.ts tsconfig.json components.json"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "get-nonce": "1.0.1",
    "lucide-react": "^1.56.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
