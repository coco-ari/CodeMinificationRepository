<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.cmr.demo</groupId><artifactId>deployment-multimodule</artifactId><version>1.0.0</version></parent>
  <artifactId>deployment-app</artifactId>
  <dependencies>
    <dependency><groupId>com.cmr.demo</groupId><artifactId>deployment-common</artifactId><version>${project.version}</version></dependency>
  </dependencies>
  <build>
    <finalName>demo</finalName>
    <!-- 显式依赖保证公共模块先完成构建，再将其类打入演示用单一可执行 JAR。 -->
    <resources>
      <resource>
        <directory>${project.basedir}/../common/target/classes</directory>
        <filtering>false</filtering>
        <includes><include>com/cmr/demo/common/**</include></includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version>
        <configuration><archive><manifest><mainClass>com.cmr.demo.Main</mainClass></manifest></archive></configuration>
      </plugin>
    </plugins>
  </build>
</project>
